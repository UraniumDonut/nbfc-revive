<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!--Includes-->
  <?include $(var.ProjectDir)Constants.wxi ?>

  <Product Id="*" Name="$(var.ProductName)" 
           Version="!(bind.fileVersion.NbfcService.exe)" 
           Language="1033" 
           Codepage="1252"
           Manufacturer="$(var.Manufacturer)"  
           UpgradeCode="$(var.UpgradeGuid)">

    <!--Package-->
    <Package InstallerVersion="300" 
             Compressed="yes"  
             Id="*" 
             InstallScope="perMachine"
             Manufacturer="$(var.Manufacturer)" 
             Description="$(var.ProductName) Installer"/>

    <!--Upgrade-->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowDowngrades="no"
                  AllowSameVersionUpgrades="no"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <!--Media-->
    <Media Id="1" Cabinet="NBFC.cab" EmbedCab="yes" CompressionLevel="high"/>
    
    <!--Replace advertised shortcuts with normal ones-->
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <!--.NET Framework check-->
    <PropertyRef Id="NETFRAMEWORK45"/>

    <Condition Message="$(var.ProductName) requires .NET Framework 4.8 or greater.">
      <![CDATA[Installed OR (NETFRAMEWORK45 >= "#528040")]]>
    </Condition>

    <!--64-bit Windows check (PawnIO and LibreHardwareMonitorLib are x64 only)-->
    <Condition Message="$(var.ProductName) 2.0 requires 64-bit Windows.">
      <![CDATA[Installed OR VersionNT64]]>
    </Condition>

    <!--PawnIO check (the bootstrapper installs PawnIO before this package)-->
    <Property Id="PAWNIOVERSION">
      <RegistrySearch Id="PawnIOVersionSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO"
                      Name="DisplayVersion"
                      Type="raw"
                      Win64="yes" />
    </Property>

    <Condition Message="$(var.ProductName) requires the PawnIO driver. Please install it using NoteBookFanControl.setup.exe, or from https://pawnio.eu first.">
      <![CDATA[Installed OR PAWNIOVERSION]]>
    </Condition>

    <!--Program Icon-->
    <Icon Id="fan.ico" SourceFile="$(var.NbfcClient.ProjectDir)fan.ico" />
    <Property Id="ARPPRODUCTICON" Value="fan.ico" />

    <!--Close NbfcClient before installation-->
    <util:CloseApplication Id="CloseNbfcClient" Target="NoteBookFanControl.exe" EndSessionMessage="yes" />
    <util:CloseApplication Id="CloseNbfcClientOld" Target="NoteBook FanControl.exe" EndSessionMessage="yes" />

    <!--Stop NbfcService before InstallValidate: if Restart Manager is disabled by policy, the built-in
        FilesInUse check reports the running service (and every process with a same-named DLL loaded)
        and blocks the uninstall. StopServices would only stop it later.-->
    <SetProperty Id="WixQuietExec64CmdLine" Value="&quot;[System64Folder]net.exe&quot; stop NbfcService"
                 Before="StopNbfcServiceEarly" Sequence="execute">REMOVE~="ALL" OR WIX_UPGRADE_DETECTED</SetProperty>
    <CustomAction Id="StopNbfcServiceEarly" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopNbfcServiceEarly" Before="InstallValidate">REMOVE~="ALL" OR WIX_UPGRADE_DETECTED</Custom>
    </InstallExecuteSequence>

    <!--Features-->
    <Feature Id="NoteBookFanControl" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="Application" />
      <ComponentGroupRef Id="Plugins" />
      <ComponentGroupRef Id="Configs" />
      <ComponentGroupRef Id="Directories" />
    </Feature>
  </Product>
</Wix>